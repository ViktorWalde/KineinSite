---
import { sitePath } from "../../site";
import { type Guide } from "./guides";
import { projectPathFor } from "./project-paths";

// Índice lateral do guia: todos os capítulos publicados da mesma seção, com
// o atual marcado (aria-current="page").
interface Props {
  guides: readonly Guide[];
  currentId: string;
}

const { guides, currentId } = Astro.props;
const currentPath = `/aprender/${currentId}/` as const;
const project = projectPathFor(currentPath);
const references = guides.filter(
  (guide) =>
    !guide.id.includes("primeiro-projeto-") &&
    (!project || guide.id !== "ide/instalar"),
);
---

<aside class="docs-sidebar guide-nav" aria-label="Capítulos do guia">
  {project && (
    <>
      <p class="label">Projeto em {project.language}</p>
      <nav aria-label={`Etapas do projeto em ${project.language}`}>
        <ol>
          {project.steps.map((step, index) => (
            <li>
              <a
                href={sitePath(step.path)}
                aria-current={step.path === currentPath ? "page" : undefined}
              >
                <span class="guide-nav-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {step.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </>
  )}
  <p class="label guide-nav-group">Uso da IDE</p>
  <nav aria-label="Guias de consulta da IDE">
    <ol>
      {references.map((guide) => (
        <li>
          <a
            href={sitePath(`/aprender/${guide.id}/`)}
            aria-current={guide.id === currentId ? "page" : undefined}
          >
            {guide.data.title}
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <a class="guide-nav-all" href={sitePath("/aprender/")}>
    Ver todos os percursos →
  </a>
</aside>
