---
import { getImage } from "astro:assets";
import posterSource from "../../../assets/ide/desenvolvimento/demo.png";
import betaPosterSource from "../../../assets/ide/demo-beta.png";
import { sitePath } from "../../site";
import "./demonstracao.css";
interface Props {
  beta?: boolean;
}
const { beta = false } = Astro.props;
const name = beta ? "vectis-0-3-5-beta" : "vectis-0-4-desenvolvimento";
const label = beta ? "beta 0.3.5" : "0.4 em desenvolvimento";
const poster = await getImage({
  src: beta ? betaPosterSource : posterSource,
  width: 1200,
  format: "webp",
  quality: 82,
});
---

<figure class="demo-video">
  <video
    controls
    preload="none"
    poster={poster.src}
    width="1600"
    height="1000"
    aria-label={`Demonstração real da Kinein Vectis ${label}, com legendas em português`}
  >
    <source src={sitePath(`/videos/${name}.mp4`)} type="video/mp4" />
    <track
      kind="captions"
      src={sitePath(`/videos/${name}.vtt`)}
      srclang="pt-BR"
      label="Português"
      default
    />
    <p>
      <a href={sitePath(`/videos/${name}.mp4`)}>
        Assistir à demonstração em MP4
      </a>
    </p>
  </video>
  <figcaption>
    <strong>{beta ? "24" : "42"} segundos na IDE real.</strong>
    {beta
      ? "Código, compilação e execução no beta 0.3.5 disponível para baixar."
      : "Código, build, execução, ferramentas e histórico Git na interface em desenvolvimento para a 0.4."}
    Gravado no Linux em 8 de outubro de 2026, sem áudio, com legendas.
  </figcaption>
</figure>
<p class="demo-transcript">
  <a
    class="inline-link"
    href={sitePath(
      beta
        ? "/aprender/ide/primeiro-projeto-cpp/"
        : "/documentacao/previa-0-4/#roteiro",
    )}
  >
    {beta
      ? "Fazer seu primeiro projeto em C++ →"
      : "Ler o roteiro e os resultados da demonstração →"}
  </a>
</p>
