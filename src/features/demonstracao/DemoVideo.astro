---
import { getImage } from "astro:assets";
import posterSource from "../../../assets/ide/desenvolvimento/demo.png";
import betaPosterSource from "../../../assets/ide/demo-beta.png";
import { sitePath } from "../../site";
import "./demonstracao.css";
interface Props {
  beta?: boolean;
}
const { beta = false } = Astro.props;
const name = beta ? "vectis-0-3-5-beta" : "vectis-0-4-desenvolvimento";
const label = beta ? "beta 0.3.5" : "0.4 em desenvolvimento";
const poster = await getImage({
  src: beta ? betaPosterSource : posterSource,
  width: 1600,
  format: "webp",
  quality: 82,
});
---

<figure class="demo-video" data-demo>
  <video
    controls
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster.src}
    width="1600"
    height="1000"
    aria-label={`Kinein Vectis ${label}: editor, compilação e execução de C++`}
  >
    <source src={sitePath(`/videos/${name}.mp4`)} type="video/mp4" />
    <p>
      <a href={sitePath(`/videos/${name}.mp4`)}>
        Assistir à demonstração em MP4
      </a>
    </p>
  </video>
  <figcaption>
    <span>
      {beta
        ? "Beta 0.3.5 · disponível para Linux"
        : "Prévia 0.4 · nova interface"}
    </span>
    <div class="demo-controls">
      <button type="button" class="demo-control" data-demo-toggle hidden>
        Reproduzir
      </button>
      <button type="button" class="demo-control" data-demo-fullscreen hidden>
        Tela cheia <span aria-hidden="true">⤢</span>
      </button>
    </div>
  </figcaption>
</figure>
<script>
  import "./demo-video";
</script>
