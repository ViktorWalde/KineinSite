---
import { ideScreens } from "../../data/ide-screens";
import { developmentScreens } from "../../data/development-screens";
import IdeGallery from "./IdeGallery.astro";
import { releaseUrl, sitePath } from "../../site";
---

<section
  id="interface"
  class="section shell section-surface ide-preview"
  aria-labelledby="interface-title"
>
  <div class="section-intro reveal">
    <p class="kicker">A INTERFACE REAL DA VECTIS</p>
    <h2 id="interface-title">Seu código, dentro da Vectis.</h2>
    <p class="section-intro-copy">
      Estas são capturas do beta {ideScreens.version}, disponível para Linux
      x86_64. Explore o editor e a detecção de ferramentas. A aba “Prévia 0.4”
      mostra uma interface ainda em desenvolvimento. Selecione uma captura para
      ampliar.
    </p>
  </div>

  <div class="gallery-versions" data-tabs>
    <div
      class="segmented-control"
      role="tablist"
      aria-label="Versão nas capturas"
      hidden
    >
      <button
        type="button"
        role="tab"
        data-tab
        id="gallery-beta-tab"
        aria-controls="gallery-beta"
        aria-selected="true"
        tabindex="0"
      >
        Beta {ideScreens.version}
        <span class="version-state">Disponível para Linux</span>
      </button>
      <button
        type="button"
        role="tab"
        data-tab
        id="gallery-preview-tab"
        aria-controls="gallery-preview"
        aria-selected="false"
        tabindex="-1"
      >
        Prévia 0.4
        <span class="version-state">Em desenvolvimento</span>
      </button>
    </div>
    <div
      id="gallery-beta"
      class="tab-panel"
      role="tabpanel"
      data-tab-panel
      aria-labelledby="gallery-beta-tab"
    >
      <h3 class="gallery-version-title">
        Beta {ideScreens.version} · disponível para Linux
      </h3>
      <IdeGallery
        id="beta"
        label={`Telas do beta ${ideScreens.version}`}
        screens={ideScreens}
      />
    </div>
    <div
      id="gallery-preview"
      class="tab-panel"
      role="tabpanel"
      data-tab-panel
      aria-labelledby="gallery-preview-tab"
    >
      <h3 class="gallery-version-title">Prévia 0.4 · em desenvolvimento</h3>
      <IdeGallery
        id="preview"
        label="Telas da prévia 0.4"
        screens={developmentScreens}
      />
    </div>
  </div>
  <div class="try-actions">
    <a
      class="button button-primary"
      href={releaseUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Baixar o beta {ideScreens.version} <span aria-hidden="true">↗</span>
    </a>
    <a
      class="button button-secondary"
      href={sitePath("/aprender/ide/primeiro-projeto-cpp/")}
    >
      Criar meu primeiro projeto C++ <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
