---
import { sitePath } from "../../site";

const areas = [
  {
    path: "/manual/",
    number: "01",
    status: "SEU AMBIENTE",
    title: "Suas ferramentas encontram seu projeto",
    description:
      "Use os compiladores e ferramentas do seu sistema. A Vectis ajuda você a reunir o trabalho e acompanhar os resultados.",
    linkText: "Consultar as ferramentas no manual",
  },
  {
    path: "/aprender/",
    number: "02",
    status: "NO SEU RITMO",
    title: "O começo vem com um guia",
    description:
      "Instale, crie um projeto e execute seu primeiro programa. Cada guia mostra os passos e o resultado que você deve encontrar.",
    linkText: "Escolher um guia",
  },
  {
    path: "/colabore/",
    number: "03",
    status: "CÓDIGO ABERTO",
    title: "Você também pode fazer parte",
    description:
      "Teste em outro ambiente, melhore uma explicação ou corrija um detalhe. Há formas de contribuir além de escrever código.",
    linkText: "Encontrar uma forma de ajudar",
  },
] as const;
---

<section
  id="foco"
  class="section shell section-surface"
  aria-labelledby="foco-title"
>
  <div class="section-intro reveal">
    <p class="kicker">FEITA PARA QUEM QUER CRIAR</p>
    <h2 id="foco-title">Seu jeito de criar tem espaço aqui.</h2>
    <p class="section-intro-copy">
      Trabalhe com seu ambiente, aprenda no seu ritmo e acompanhe um projeto de
      código aberto sendo construído.
    </p>
  </div>
  <div class="area-grid auto-grid reveal-children">
    {areas.map((area) => (
      <a class="area-card card card-interactive" href={sitePath(area.path)}>
        <span class="label">
          {area.number} / {area.status}
        </span>
        <h3>{area.title}</h3>
        <p>{area.description}</p>
        <span class="inline-link">
          {area.linkText}{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </span>
      </a>
    ))}
  </div>
</section>
