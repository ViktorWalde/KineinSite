---
import { sitePath } from "../../site";

const areas = [
  {
    path: "/documentacao/#embarcados",
    number: "01",
    status: "DO DISPOSITIVO AO SISTEMA",
    title: "Perto do hardware, com novos horizontes",
    description:
      "Do bare metal às aplicações em Linux embarcado, o trabalho com dispositivos orienta a evolução da Vectis e os fluxos em construção na 0.4.",
    linkText: "Conhecer esse caminho",
  },
  {
    path: "/estudos/cpp/telemetria-local/",
    number: "02",
    status: "IOT E SISTEMAS CONECTADOS",
    title: "Pequenas leituras, novas possibilidades",
    description:
      "Sensores e dados são parte desse universo. Explore um primeiro estudo de telemetria em C++, com leituras simuladas no computador.",
    linkText: "Experimentar o estudo",
  },
  {
    path: "/documentacao/#ros2",
    number: "03",
    status: "ROBÓTICA NO HORIZONTE",
    title: "Ideias que percebem, conectam e agem",
    description:
      "A robótica também faz parte desse horizonte. Conheça a direção do projeto para ROS 2 e aplicações robóticas, entre as frentes futuras da IDE.",
    linkText: "Ver a direção do projeto",
  },
] as const;
---

<section
  id="foco"
  class="section shell section-surface"
  aria-labelledby="foco-title"
>
  <div class="section-intro reveal">
    <p class="kicker">UMA ESPECIALIDADE EM CONSTRUÇÃO</p>
    <h2 id="foco-title">Um universo de projetos embarcados.</h2>
    <p class="section-intro-copy">
      Cada projeto tem seu próprio alvo e seus próprios desafios. A Vectis está
      evoluindo para se especializar nesse universo, dos dispositivos mais
      simples aos sistemas conectados e à robótica.
    </p>
  </div>
  <div class="area-grid auto-grid reveal-children">
    {areas.map((area) => (
      <a class="area-card card card-interactive" href={sitePath(area.path)}>
        <span class="label">
          {area.number} / {area.status}
        </span>
        <h3>{area.title}</h3>
        <p>{area.description}</p>
        <span class="inline-link">
          {area.linkText}{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </span>
      </a>
    ))}
  </div>
</section>
