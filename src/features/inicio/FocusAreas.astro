---
import { sitePath } from "../../site";

const areas = [
  {
    id: "embarcados",
    number: "01",
    status: "Foco da 0.4",
    title: "Bare metal e Linux embarcado",
    description:
      "Uma base prática para trabalhar com firmware e projetos embarcados. Os alvos e fluxos suportados serão confirmados conforme a 0.4 for testada.",
    linkText: "Ver o caminho para embarcados",
  },
  {
    id: "iot",
    number: "02",
    status: "Parcial no beta",
    title: "IoT e IIoT",
    description:
      "Projetos que atravessam firmware, gateway, serviços e dados. A Vectis busca manter visíveis as escolhas feitas em cada camada.",
    linkText: "Ver o roteiro para IoT e IIoT",
  },
  {
    id: "backend",
    number: "03",
    status: "Recursos no beta",
    title: "Backend e dados",
    description:
      "Python para APIs, automação e testes, com ferramentas de containers e acesso a PostgreSQL, TimescaleDB, SQLite e MongoDB.",
    linkText: "Ver Python, backend e dados",
  },
  {
    id: "ros2",
    number: "04",
    status: "Direção futura",
    title: "ROS 2 e robótica",
    description:
      "Workspaces e execução de pacotes ROS 2 estão no radar do produto. A integração ainda precisa ser implementada e verificada.",
    linkText: "Ver o estado de ROS 2",
  },
] as const;
---

<section
  id="foco"
  class="section shell section-surface"
  aria-labelledby="foco-title"
>
  <div class="section-intro reveal">
    <p class="kicker">PARA ONDE A VECTIS CAMINHA</p>
    <h2 id="foco-title">
      Uma IDE com direção: código, dispositivos e sistemas.
    </h2>
    <p class="section-intro-copy">
      A 0.4 concentra o próximo passo em embarcados. IoT, serviços e dados
      completam a direção do produto; cada área indica seu estágio atual.
    </p>
  </div>
  <div class="area-grid auto-grid reveal-children">
    {areas.map((area) => (
      <a
        class="area-card card card-interactive"
        href={sitePath(`/documentacao/#${area.id}`)}
      >
        <span class="label">
          {area.number} / {area.status}
        </span>
        <h3>{area.title}</h3>
        <p>{area.description}</p>
        <span class="inline-link">
          {area.linkText}{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </span>
      </a>
    ))}
  </div>
</section>
