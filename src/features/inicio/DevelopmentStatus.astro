---
import { developmentSnapshot } from "../../data/development";
import { developmentScreens } from "../../data/development-screens";
import IdeGallery from "./IdeGallery.astro";
import DemoVideo from "../demonstracao/DemoVideo.astro";
import { formatDate, publicVersion, releaseUrl } from "../../site";

const updatedAt = new Date(`${developmentSnapshot.updatedAt}T00:00:00Z`);
---

<section
  id="desenvolvimento"
  class="section shell section-surface"
  aria-labelledby="desenvolvimento-title"
>
  <div class="section-intro reveal">
    <p class="kicker">PRÓXIMA VERSÃO · EM DESENVOLVIMENTO</p>
    <h2 id="desenvolvimento-title">{developmentSnapshot.title}</h2>
    <p class="section-intro-copy">
      A {developmentSnapshot.version} reúne a reformulação da interface e o foco
      em embarcados. O executável de desenvolvimento já permite ver a interface
      em construção. Plano atualizado em{" "}
      <time datetime={developmentSnapshot.updatedAt}>
        {formatDate(updatedAt)}
      </time>
      . Para experimentar a versão pública disponível, baixe o{" "}
      <a
        class="inline-link"
        href={releaseUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {publicVersion} beta <span aria-hidden="true">↗</span>
      </a>
      .
    </p>
  </div>
  <div class="development-grid auto-grid reveal-children">
    {developmentSnapshot.groups.map((group) => (
      <article class="development-card card">
        <h3>{group.status}</h3>
        <ul>
          {group.items.map((item) => (
            <li>
              <span>
                <strong>{item.title}</strong>
                {"detail" in item && <small>{item.detail}</small>}
              </span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
  <IdeGallery
    id="preview"
    label="Capturas da prévia 0.4"
    screens={developmentScreens}
  />
  <DemoVideo />
  <p class="development-note">
    A {developmentSnapshot.version} está em desenvolvimento. As telas e o escopo
    ainda podem mudar; a prévia apresenta o trabalho em construção.
  </p>
</section>
