---
import { developmentSnapshot } from "../../data/development";
import DemoComparison from "../demonstracao/DemoComparison.astro";
import PreviewNotice from "../demonstracao/PreviewNotice.astro";
---

<section
  id="desenvolvimento"
  class="section shell section-surface"
  aria-labelledby="desenvolvimento-title"
>
  <div class="section-intro reveal">
    <p class="kicker">A PRÓXIMA VECTIS</p>
    <h2 id="desenvolvimento-title">{developmentSnapshot.title}</h2>
    <p class="section-intro-copy">
      Nova interface e trabalho com embarcados, juntos na{" "}
      {developmentSnapshot.version}. Veja como o editor e os painéis estão
      tomando forma — e compare com o beta que você pode usar hoje.
    </p>
  </div>
  <PreviewNotice />
  <p class="comparison-intro">
    Compare o mesmo projeto C++ nas duas interfaces: código, compilação e
    resultado. Escolha a versão que deseja ver.
  </p>
  <DemoComparison />
  <div class="development-grid auto-grid reveal-children">
    {developmentSnapshot.groups.map((group) => (
      <article class="development-card card">
        <h3>{group.status}</h3>
        <ul>
          {group.items.map((item) => (
            <li>
              <span>
                <strong>{item.title}</strong>
                {"detail" in item && <small>{item.detail}</small>}
              </span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
