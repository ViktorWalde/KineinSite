---
import { getLatestUpdate } from "../atualizacoes/updates";
import { changelogUrl, manualUrl, publicVersion, sitePath } from "../../site";

const latest = await getLatestUpdate();
const notePath = sitePath(
  latest ? `/atualizacoes/${latest.id}/` : "/atualizacoes/",
);
---

<section id="estado" class="section shell" aria-labelledby="estado-title">
  <div class="section-intro reveal">
    <p class="kicker">NA VERSÃO PÚBLICA</p>
    <h2 id="estado-title">O que já funciona hoje.</h2>
    <p class="section-intro-copy">
      A versão pública é a{" "}
      <strong>{publicVersion}, beta para Linux x86_64</strong>. O pacote traz a
      interface, o core e o Qt; compiladores, SDKs e ferramentas vêm do seu
      sistema, então o que funciona em cada projeto depende do que está
      instalado e do alvo.
    </p>
  </div>
  <div class="status-panel card reveal">
    <div>
      <h3>Beta público</h3>
      <p>
        A série 0.x é beta: interfaces, configurações e fluxos podem mudar.
        Requisitos e instalação estão na{" "}
        <a class="inline-link" href={notePath}>
          nota da {publicVersion}
        </a>
        .
      </p>
    </div>
    <div class="status-actions">
      <a
        class="button button-secondary"
        href={manualUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Ler o manual da IDE <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="current-capabilities auto-grid reveal-children">
    <div class="card">
      <h3>Projeto e editor</h3>
      <p>
        Árvore do projeto, editor com Tree-sitter e inteligência de código por
        clangd, rust-analyzer e basedpyright.
      </p>
    </div>
    <div class="card">
      <h3>Executar e investigar</h3>
      <p>
        Build, testes, cobertura e depuração como tarefas canceláveis, e um
        terminal integrado de verdade (PTY).
      </p>
    </div>
    <div class="card">
      <h3>Além do editor</h3>
      <p>
        Git, Remote SSH, embarcados, containers, bancos e Grafana, cada um com
        os próprios pré-requisitos.
      </p>
    </div>
  </div>
  <p class="status-source">
    O detalhe de cada recurso está no{" "}
    <a
      class="inline-link"
      href={changelogUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      changelog da IDE <span aria-hidden="true">↗</span>
    </a>
    .
  </p>
</section>
