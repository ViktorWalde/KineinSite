---
import { releaseUrl, sitePath } from "../../site";
import CppJourney from "../aprender/CppJourney.astro";
import LanguageStarts from "../aprender/LanguageStarts.astro";
---

<section
  id="experiencia"
  class="section shell section-surface"
  aria-labelledby="experiencia-title"
>
  <div class="section-intro reveal">
    <p class="kicker">APRENDA FAZENDO · C++</p>
    <h2 id="experiencia-title">Seu primeiro C++, passo a passo.</h2>
    <p class="section-intro-copy">
      Comece com uma mensagem no terminal. Depois, faça o mesmo programa
      calcular temperaturas e trabalhar com mais leituras. Você segue em C++, no
      projeto <code>ola-kinein</code>, de uma etapa para a outra.
    </p>
  </div>
  <CppJourney />
  <div class="try-actions">
    <a class="button button-primary" href={sitePath("/aprender/ide/instalar/")}>
      Começar pela instalação <span aria-hidden="true">→</span>
    </a>
    <a
      class="inline-link"
      href={releaseUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Já conhece a Vectis? Baixe o beta <span aria-hidden="true">↗</span>
    </a>
  </div>
  <LanguageStarts />
</section>
