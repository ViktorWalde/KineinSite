---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate } from "../../site";
import ImageViewer from "../imagens/ImageViewer.astro";
import "./ide-preview.css";

interface Props {
  id: string;
  label: string;
  screens: {
    version: string;
    capturedAt: string;
    environment: string;
    shots: readonly {
      id: string;
      title: string;
      image: ImageMetadata;
      alt: string;
      caption: string;
    }[];
  };
}
const { id, label, screens } = Astro.props;
const shots = await Promise.all(
  screens.shots.map(async (shot) => ({
    ...shot,
    optimized: await getImage({
      src: shot.image,
      format: "webp",
      quality: 82,
      widths: [800, 1200, 1600],
      sizes: "min(64rem, 104svh, calc(100vw - 2rem))",
    }),
  })),
);
const capturedAt = new Date(`${screens.capturedAt}T00:00:00Z`);
---

<div class="ide-preview-frame" data-image-viewer data-tabs>
  <div
    class="ide-tabs segmented-control"
    role="tablist"
    aria-label={label}
    hidden
  >
    {shots.map((shot, index) => (
      <button
        type="button"
        role="tab"
        data-tab
        class="ide-tab"
        id={`${id}-tab-${shot.id}`}
        aria-controls={`${id}-shot-${shot.id}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
      >
        {shot.title}
      </button>
    ))}
  </div>
  {shots.map((shot) => (
    <figure
      class="ide-shot tab-panel"
      data-tab-panel
      id={`${id}-shot-${shot.id}`}
      aria-labelledby={`${id}-tab-${shot.id}`}
    >
      <a
        class="ide-image-open"
        href={shot.optimized.src}
        data-image-open
        aria-label={`Ampliar captura: ${shot.title}`}
        aria-haspopup="dialog"
      >
        <img
          src={shot.optimized.src}
          srcset={shot.optimized.srcSet.attribute}
          sizes="min(64rem, 104svh, calc(100vw - 2rem))"
          width={shot.optimized.attributes["width"]}
          height={shot.optimized.attributes["height"]}
          alt={shot.alt}
          loading="lazy"
          decoding="async"
        />
        <span class="ide-image-hint">
          Ampliar captura <span aria-hidden="true">⤢</span>
        </span>
      </a>
      <figcaption>{shot.caption} </figcaption>
    </figure>
  ))}
  <details class="ide-capture-origin">
    <summary>Sobre estas capturas</summary>
    <p>
      Kinein Vectis {screens.version} · {screens.environment} ·{" "}
      <time datetime={screens.capturedAt}>{formatDate(capturedAt)}</time>.
    </p>
  </details>
  <ImageViewer id={id} />
</div>
<script>
  import "../../scripts/tabs";
</script>
