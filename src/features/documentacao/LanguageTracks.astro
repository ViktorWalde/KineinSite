---
import { manualUrl, repositoryUrl, sitePath } from "../../site";

const tracks = [
  {
    language: "C",
    status: "EM PREPARAÇÃO",
    path: "Programa local de amostras: compilar, executar e verificar resultados. Firmware vem depois.",
    destination: "Ver C na IDE",
    href: `${repositoryUrl}#c-e-c`,
    external: true,
  },
  {
    language: "C++",
    status: "ESTUDO DISPONÍVEL",
    path: "Comece no software de IoT: processe telemetria simulada em C++20. O projeto guiado na IDE virá após a validação do fluxo.",
    destination: "Estudar telemetria local",
    href: sitePath("/estudos/cpp/telemetria-local/"),
    external: false,
  },
  {
    language: "Rust",
    status: "EM PREPARAÇÃO",
    path: "Projeto local com Cargo, tratamento de erros e testes. Targets específicos vêm depois.",
    destination: "Ver Rust na IDE",
    href: `${repositoryUrl}#rust`,
    external: true,
  },
  {
    language: "Python",
    status: "EM PREPARAÇÃO",
    path: "Ambiente virtual, relatório CSV e testes locais com unittest. API e banco vêm depois.",
    destination: "Python no manual",
    href: `${manualUrl}#10-python`,
    external: true,
  },
] as const;
---

<section
  id="linguagens"
  class="docs-section"
  aria-labelledby="linguagens-title"
>
  <div class="docs-heading">
    <span class="label">04 / LINGUAGENS</span>
    <h2 id="linguagens-title">Quatro percursos de linguagem.</h2>
  </div>
  <p>
    Conteúdo próprio em português, baseado nas fontes de cada ecossistema. Os
    estudos de linguagem mostram conceitos executados e verificados; os projetos
    na IDE virão após o teste na versão indicada.
  </p>
  <div class="path-grid">
    {tracks.map((track) => (
      <article class="path-card card">
        <span class="label">{track.status}</span>
        <h3>{track.language}</h3>
        <p>{track.path}</p>
        <a
          href={track.href}
          target={track.external ? "_blank" : undefined}
          rel={track.external ? "noopener noreferrer" : undefined}
        >
          {track.destination}{" "}
          <span aria-hidden="true">{track.external ? "↗" : "→"}</span>
        </a>
      </article>
    ))}
  </div>
</section>
