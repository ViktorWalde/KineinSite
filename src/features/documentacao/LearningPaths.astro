---
import { manualUrl, repositoryUrl } from "../../site";

const paths = [
  {
    id: "embarcados",
    title: "Bare metal e Linux embarcado",
    status: "Manual disponível · guia local planejado",
    description:
      "Comece por projeto, kit, toolchain e alvo. O roteiro de guias cobrirá build, gravação, depuração e execução em Linux embarcado com exemplos testados.",
    next: "Depois dos projetos locais: exemplo com alvo e ferramenta verificados.",
    links: [
      {
        label: "Ver embarcados no README",
        href: `${repositoryUrl}#embedded--firmware`,
      },
    ],
  },
  {
    id: "iot",
    title: "IoT e IIoT",
    status: "Foco editorial · guia local planejado",
    description:
      "O caminho proposto liga firmware, gateway, serviço e dados. Cada integração será publicada com plataforma, ferramentas e versão verificadas.",
    next: "Depois dos guias básicos: fluxo de dispositivo até serviço, quando testado.",
    links: [
      {
        label: "Entender o escopo de IoT",
        href: `${repositoryUrl}#iot-edge-e-software-de-apoio`,
      },
    ],
  },
  {
    id: "backend",
    title: "Backend e bancos de dados",
    status: "Manual disponível · guia local planejado",
    description:
      "Python, testes, containers e os painéis de PostgreSQL, TimescaleDB, SQLite e MongoDB já fazem parte da documentação da IDE.",
    next: "Depois do relatório local em Python: API, teste e inspeção de dados.",
    links: [
      {
        label: "Python no manual",
        href: `${manualUrl}#10-python`,
      },
      {
        label: "Bancos no manual",
        href: `${manualUrl}#banco-de-dados`,
      },
    ],
  },
  {
    id: "ros2",
    title: "ROS 2 e robótica",
    status: "Direção futura",
    description:
      "A integração e a simulação ROS 2 estão no radar do produto. Ainda não há fluxo ROS 2 confirmado para ensinar como recurso da IDE.",
    next: "Publicar um guia quando abertura, execução e emulação forem testadas.",
    links: [],
  },
] as const;
---

<section id="trilhas" class="docs-section" aria-labelledby="trilhas-title">
  <div class="docs-heading">
    <span class="label">03 / ESCOLHER UM CAMINHO</span>
    <h2 id="trilhas-title">Aprenda pela tarefa e pelo ambiente.</h2>
  </div>
  <p>
    Estas são as áreas que vão organizar os tutoriais do site. O status em cada
    cartão distingue a documentação disponível dos fluxos ainda planejados.
  </p>
  <div class="path-grid">
    {paths.map((path) => (
      <article class="path-card card" id={path.id}>
        <span class="label">{path.status}</span>
        <h3>{path.title}</h3>
        <p>{path.description}</p>
        <p>
          <strong>Etapa de domínio:</strong> {path.next}
        </p>
        {path.links.length > 0 && (
          <div class="path-card-links">
            {path.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
