---
import { getImage } from "astro:assets";
import icon from "../../assets/icon-amber.png";
import { discordUrl, publicVersion, releaseUrl, sitePath } from "../site";
import ThemeControls from "./ThemeControls.astro";

interface Props {
  current?: "home" | "guide" | "manual" | "docs" | "updates" | undefined;
}

const { current } = Astro.props;
const optimizedIcon = await getImage({ src: icon, width: 84, format: "webp" });
---

<header class="site-header">
  <div class="shell header-inner">
    <a
      class="brand"
      href={sitePath("/")}
      aria-label="Kinein Vectis, página inicial"
    >
      <img
        src={optimizedIcon.src}
        width="34"
        height="34"
        alt=""
        decoding="async"
      />
      <span>
        Kinein <strong>Vectis</strong>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Navegação principal">
      <a
        href={sitePath("/aprender/")}
        aria-current={current === "guide" ? "page" : undefined}
      >
        Guia
      </a>
      <a
        href={sitePath("/manual/")}
        aria-current={current === "manual" ? "page" : undefined}
      >
        Manual
      </a>
      <a
        href={sitePath("/documentacao/")}
        aria-current={current === "docs" ? "page" : undefined}
      >
        Documentação
      </a>
      <a
        href={sitePath("/atualizacoes/")}
        aria-current={current === "updates" ? "page" : undefined}
      >
        Atualizações
      </a>
      <a
        class="nav-external"
        href={discordUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Discord <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="header-tools">
      <ThemeControls />
      <a
        class="button button-primary button-small header-download"
        href={releaseUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Baixar {publicVersion} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>
