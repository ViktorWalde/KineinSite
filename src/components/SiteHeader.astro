---
import { getImage } from "astro:assets";
import icon from "../../assets/icon-amber.png";
import { publicVersion, releaseUrl, sitePath, type SiteSection } from "../site";
import ThemeControls from "./ThemeControls.astro";
import SiteNavigation from "./SiteNavigation.astro";

interface Props {
  current?: SiteSection | undefined;
}

const { current } = Astro.props;
const optimizedIcon = await getImage({ src: icon, width: 84, format: "webp" });
---

<header class="site-header">
  <div class="shell header-inner">
    <a
      class="brand"
      href={sitePath("/")}
      aria-label="Kinein Vectis, página inicial"
    >
      <img
        src={optimizedIcon.src}
        width="34"
        height="34"
        alt=""
        decoding="async"
      />
      <span>
        Kinein <strong>Vectis</strong>
      </span>
    </a>

    <SiteNavigation current={current} />

    <div class="header-tools">
      <ThemeControls />
      <a
        class="button button-primary button-small header-download"
        href={releaseUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Baixar {publicVersion} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <details class="mobile-navigation">
      <summary>
        <span>Explorar o site</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <SiteNavigation current={current} mobile />
    </details>
  </div>
</header>

<script src="../scripts/navigation.ts"></script>
