---
import { getImage } from "astro:assets";
import icon from "../../assets/icon-amber.png";
import { publicVersion, releaseUrl, type SiteSection } from "../site";
import { defaultLocale, type Locale } from "../i18n/config";
import { resolveRoute } from "../i18n/routing";
import { uiFor } from "../i18n/ui";
import ThemeControls from "./ThemeControls.astro";
import SiteNavigation from "./SiteNavigation.astro";
import { resolveNavigation } from "../data/navigation";
import { getPublishedGuides } from "../features/aprender/guides";
import { getUpdates } from "../features/atualizacoes/updates";

interface Props {
  current?: SiteSection | undefined;
  locale?: Locale;
}

const { current, locale = defaultLocale } = Astro.props;
const messages = uiFor(locale);
const groups = resolveNavigation({
  guides: await getPublishedGuides(),
  updates: await getUpdates(),
  locale,
  base: import.meta.env.BASE_URL,
});
const optimizedIcon = await getImage({ src: icon, width: 84, format: "webp" });
---

<header class="site-header">
  <div class="shell header-inner">
    <a
      class="brand"
      href={resolveRoute("home", locale, import.meta.env.BASE_URL).href}
      aria-label={messages.home}
    >
      <img
        src={optimizedIcon.src}
        width="34"
        height="34"
        alt=""
        decoding="async"
      />
      <span>
        Kinein <strong>Vectis</strong>
      </span>
    </a>

    <SiteNavigation current={current} locale={locale} groups={groups} />

    <div class="header-tools">
      <ThemeControls locale={locale} />
      <a
        class="button button-primary button-small header-download"
        href={releaseUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {messages.download} {publicVersion} <span aria-hidden="true">↗</span>
        <span class="visually-hidden"> — {messages.hud.newTab}</span>
      </a>
    </div>
    <details class="mobile-navigation">
      <summary>
        <span>{messages.explore}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <SiteNavigation
        current={current}
        locale={locale}
        groups={groups}
        mobile
      />
    </details>
  </div>
</header>

<script src="../scripts/navigation.ts"></script>
