---
import {
  discordUrl,
  publicVersion,
  repositoryUrl,
  siteRepositoryUrl,
} from "../site";
import { defaultLocale, type Locale } from "../i18n/config";
import { resolveRoute, type RouteId } from "../i18n/routing";
import { uiFor } from "../i18n/ui";

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const messages = uiFor(locale).footer;
const route = (id: RouteId) =>
  resolveRoute(id, locale, import.meta.env.BASE_URL).href;

const groups = [
  {
    title: messages.product,
    links: [
      { label: messages.updates, href: route("updates") },
      {
        label: `${messages.download} ${publicVersion}`,
        href: `${route("install")}#baixar-beta`,
      },
      { label: messages.ideCode, href: repositoryUrl, external: true },
    ],
  },
  {
    title: messages.learn,
    links: [
      { label: messages.guide, href: route("guide") },
      { label: messages.docs, href: route("docs") },
      { label: messages.manual, href: route("manual") },
    ],
  },
  {
    title: messages.community,
    links: [
      { label: messages.collaborate, href: route("collaborate") },
      {
        label: messages.contributors,
        href: `${route("collaborate")}#colaboradores`,
      },
      { label: "Discord", href: discordUrl, external: true },
      { label: messages.about, href: route("site") },
      { label: messages.siteCode, href: siteRepositoryUrl, external: true },
    ],
  },
];
---

<footer class="site-footer">
  <nav class="shell footer-grid" aria-label={messages.label}>
    <div class="footer-intro">
      <strong>
        Kinein <span>Vectis</span>
      </strong>
      <p>{messages.intro}</p>
    </div>
    {groups.map((group) => (
      <div class="footer-group">
        <p class="label">{group.title}</p>
        {group.links.map((link) =>
          link.external ? (
            <a
              class="footer-link"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          ),
        )}
      </div>
    ))}
  </nav>
  <div class="shell footer-bottom">
    <p>
      {messages.beta} {publicVersion} {messages.platform}
    </p>
  </div>
</footer>
