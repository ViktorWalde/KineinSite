---
import {
  discordUrl,
  publicVersion,
  releaseUrl,
  repositoryUrl,
  sitePath,
  siteRepositoryUrl,
} from "../site";

const groups = [
  {
    title: "Produto",
    links: [
      { label: "Atualizações", href: sitePath("/atualizacoes/") },
      { label: `Baixar a ${publicVersion}`, href: releaseUrl, external: true },
      { label: "Código da IDE", href: repositoryUrl, external: true },
    ],
  },
  {
    title: "Aprender",
    links: [
      { label: "Guia da IDE", href: sitePath("/aprender/") },
      { label: "Documentação", href: sitePath("/documentacao/") },
      { label: "Manual da IDE", href: sitePath("/manual/") },
    ],
  },
  {
    title: "Comunidade",
    links: [
      { label: "Discord", href: discordUrl, external: true },
      { label: "Sobre este site", href: sitePath("/documentacao/site/") },
      { label: "Código do site", href: siteRepositoryUrl, external: true },
    ],
  },
];
---

<footer class="site-footer">
  <nav class="shell footer-grid" aria-label="Rodapé">
    <div class="footer-intro">
      <strong>
        Kinein <span>Vectis</span>
      </strong>
      <p>
        IDE open source para C, C++, Rust e Python. Editor, compilação, testes e
        Git no beta; nova interface e foco em embarcados na 0.4.
      </p>
    </div>
    {groups.map((group) => (
      <div class="footer-group">
        <p class="label">{group.title}</p>
        {group.links.map((link) =>
          link.external ? (
            <a
              class="footer-link"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          ),
        )}
      </div>
    ))}
  </nav>
  <div class="shell footer-bottom">
    <p>
      Beta público {publicVersion} para Linux x86_64. A IDE não tem telemetria.
    </p>
  </div>
</footer>
