---
import {
  discordUrl,
  publicVersion,
  releaseUrl,
  repositoryUrl,
  sitePath,
} from "../site";
---

<footer class="site-footer">
  <div class="shell footer-top">
    <div class="footer-intro">
      <strong>Kinein Vectis</strong>
      <p>
        Beta público {publicVersion} para C, C++, Rust e Python no Linux x86_64.
      </p>
    </div>
    <a
      class="footer-discord"
      href={discordUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Discord <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="shell footer-bottom">
    <nav aria-label="Links do projeto">
      <a href={sitePath("/atualizacoes/")}>Atualizações</a>
      <a href={sitePath("/documentacao/")}>Documentação</a>
      <a href={sitePath("/documentacao/site/")}>Sobre este site</a>
      <a href={releaseUrl} target="_blank" rel="noopener noreferrer">
        Download {publicVersion}
      </a>
      <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">
        Repositório
      </a>
    </nav>
  </div>
</footer>
