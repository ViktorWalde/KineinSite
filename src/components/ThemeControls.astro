<details class="appearance">
  <summary>
    Tema <span aria-hidden="true">⌄</span>
  </summary>
  <div class="appearance-panel">
    <label for="theme-choice">Tema</label>
    <select id="theme-choice" name="theme">
      <option value="system">Seguir o sistema</option>
      <option value="light">Claro</option>
      <option value="dark">Escuro</option>
      <option value="warm">Quente</option>
    </select>

    <label for="accent-choice">Cor de destaque</label>
    <select id="accent-choice" name="accent">
      <option value="amber">Âmbar</option>
      <option value="blue">Azul</option>
      <option value="teal">Verde-azulado</option>
    </select>
    <p>A preferência fica somente neste navegador.</p>
  </div>
</details>
