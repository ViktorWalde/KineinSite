---
import { discordUrl, type SiteSection } from "../site";
import { defaultLocale, type Locale } from "../i18n/config";
import { resolveRoute } from "../i18n/routing";
import { uiFor } from "../i18n/ui";

interface Props {
  current?: SiteSection | undefined;
  mobile?: boolean;
  locale?: Locale;
}
const { current, mobile = false, locale = defaultLocale } = Astro.props;
const messages = uiFor(locale);
const links = ["collaborate", "guide", "manual", "docs", "updates"] as const;
---

<nav
  class:list={["primary-nav", mobile ? "mobile-links" : "desktop-links"]}
  aria-label={mobile ? messages.mobileNavigation : messages.navigation}
>
  {links.map((section) => (
    <a
      class:list={{ "nav-collaborate": section === "collaborate" }}
      href={resolveRoute(section, locale, import.meta.env.BASE_URL).href}
      aria-current={current === section ? "page" : undefined}
    >
      {messages.nav[section]}
    </a>
  ))}
  <a
    class="nav-external"
    href={discordUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    Discord <span aria-hidden="true">↗</span>
  </a>
</nav>
