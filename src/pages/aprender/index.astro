---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideList from "../../features/aprender/GuideList.astro";
import {
  getPublishedGuides,
  sectionNames,
  sectionOf,
} from "../../features/aprender/guides";
import { publicVersion } from "../../site";
import "../../features/aprender/aprender.css";

const guides = await getPublishedGuides();
const ideGuides = guides.filter((guide) => sectionOf(guide) === "ide");
const totalMinutes = ideGuides.reduce(
  (sum, guide) => sum + guide.data.minutes,
  0,
);
const chapterCount =
  ideGuides.length === 1 ? "1 capítulo" : `${ideGuides.length} capítulos`;
---

<BaseLayout
  current="guide"
  title="Aprender"
  description={`Guia da Kinein Vectis para iniciantes: da instalação ao primeiro projeto, cada passo reproduzido na versão ${publicVersion}.`}
>
  <div class="learn shell">
    <header class="learn-intro enter">
      <p class="kicker">APRENDER · GUIA DA IDE</p>
      <h1>Da instalação ao primeiro projeto.</h1>
      <p class="learn-intro-copy">
        Capítulos curtos, na ordem em que você vai precisar deles. Cada passo
        foi reproduzido na IDE de verdade, com as telas que aparecem para você.
        {ideGuides.length > 0 && (
          <>
            {" "}
            Até agora: {chapterCount}, cerca de {totalMinutes} minutos no total.
          </>
        )}
      </p>
    </header>

    <section aria-labelledby="guia-title">
      <h2 id="guia-title" class="visually-hidden">
        {sectionNames.ide}
      </h2>
      <GuideList guides={ideGuides} />
      {ideGuides.length === 0 && (
        <p class="learn-empty">
          Os primeiros capítulos estão sendo reproduzidos na {publicVersion}.
        </p>
      )}
    </section>
  </div>
</BaseLayout>
