---
import { getImage } from "astro:assets";
import wallpaperSource from "../../assets/backgrounds/wallpaper-site.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import CurrentStatus from "../features/inicio/CurrentStatus.astro";
import DevelopmentStatus from "../features/inicio/DevelopmentStatus.astro";
import FocusAreas from "../features/inicio/FocusAreas.astro";
import IdePreview from "../features/inicio/IdePreview.astro";
import FirstTry from "../features/inicio/FirstTry.astro";
import LatestUpdate from "../features/atualizacoes/LatestUpdate.astro";
import "../features/inicio/inicio.css";
import "../features/inicio/background.css";
import "../features/inicio/secoes.css";
import "../features/inicio/desenvolvimento.css";
import { developmentSnapshot } from "../data/development";
import { discordUrl, publicVersion, releaseUrl } from "../site";

// O hero é o maior elemento da primeira tela: largura certa por tela
// (srcset) e prioridade de rede alta. As dimensões vêm do resultado, nunca
// de wallpaperSource.width: ler uma propriedade da imagem importada faz o
// Astro publicar o PNG original (2 MB) junto, sem nenhuma página usá-lo.
const wallpaper = await getImage({
  src: wallpaperSource,
  format: "webp",
  quality: 76,
  widths: [768, 1280, 1672],
  sizes: "100vw",
});
---

<BaseLayout
  current="home"
  title="IDE open source para C, C++, Rust e Python"
  description={`Edite, compile, execute testes e consulte o Git na Kinein Vectis. Beta ${publicVersion} para Linux x86_64. Conheça a nova interface e o foco em embarcados da 0.4.`}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <img
        class="hero-bg"
        src={wallpaper.src}
        srcset={wallpaper.srcSet.attribute}
        sizes="100vw"
        width={wallpaper.attributes["width"]}
        height={wallpaper.attributes["height"]}
        alt=""
        fetchpriority="high"
      />
      <div class="hero-shine"></div>
    </div>
    <div class="shell hero-layout">
      <div class="hero-art" aria-hidden="true"></div>
      <div class="hero-copy enter">
        <p class="hero-overline">
          <span aria-hidden="true">∭</span> BETA PÚBLICO {publicVersion} · LINUX
          X86_64
        </p>
        <h1 id="hero-title">
          Do código à execução. <em>Na mesma IDE.</em>
        </h1>
        <p class="hero-lead">
          Abra seu projeto em C, C++, Rust ou Python. Edite o código, acompanhe
          a compilação, rode testes e consulte o Git na mesma janela.
        </p>
        <div class="hero-actions">
          <a
            class="button button-primary"
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Testar o beta {publicVersion} no Linux{" "}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-quiet" href="#desenvolvimento">
            Conhecer a próxima Vectis
          </a>
        </div>
        <p class="hero-meta">
          Open source, MIT ou Apache-2.0 <span aria-hidden="true">·</span> Sem
          telemetria <span aria-hidden="true">·</span> Ferramentas do seu
          sistema
        </p>
      </div>
    </div>
  </section>

  <div class="home-flow">
    <div class="home-topic wave-field">
      <CurrentStatus />

      <nav class="journey shell auto-grid reveal" aria-label="Caminhos rápidos">
        <a class="card card-interactive" href="#interface">
          <span class="journey-label label">01 / CONHEÇA</span>
          <strong>Veja as duas interfaces</strong>
          <span class="journey-arrow" aria-hidden="true">
            ↓
          </span>
        </a>
        <a class="card card-interactive" href="#desenvolvimento">
          <span class="journey-label label">02 / A PRÓXIMA VECTIS</span>
          <strong>
            Compare o beta com a prévia {developmentSnapshot.version}
          </strong>
          <span class="journey-arrow" aria-hidden="true">
            ↓
          </span>
        </a>
        <a class="card card-interactive" href="#experiencia">
          <span class="journey-label label">03 / EXPERIMENTE</span>
          <strong>Comece seu projeto em C++</strong>
          <span class="journey-arrow" aria-hidden="true">
            ↓
          </span>
        </a>
      </nav>
    </div>

    <div class="home-topic wave-field">
      <DevelopmentStatus />
    </div>

    <div class="home-topic wave-field">
      <IdePreview />
    </div>

    <div class="home-topic wave-field">
      <FocusAreas />
    </div>

    <div class="home-topic wave-field">
      <FirstTry />
    </div>

    <div class="home-topic wave-field">
      <LatestUpdate />
    </div>

    <div class="home-topic wave-field">
      <section class="closing-section" aria-labelledby="closing-title">
        <div class="shell closing-layout reveal">
          <div>
            <p class="kicker">BETA PÚBLICO {publicVersion}</p>
            <h2 id="closing-title">Comece pelo seu próximo projeto.</h2>
            <p>
              Comece pelo beta {publicVersion} ou acompanhe a construção da
              {developmentSnapshot.version}. Seu primeiro teste pode ajudar a
              definir a IDE que está por vir.
            </p>
          </div>
          <div class="closing-actions">
            <a
              class="button button-primary"
              href={releaseUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Testar o beta {publicVersion} <span aria-hidden="true">↗</span>
            </a>
            <a
              class="inline-link"
              href={discordUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Entrar no Discord da Vectis <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
