---
import { getImage } from "astro:assets";
import wallpaperSource from "../../assets/backgrounds/wallpaper-site.png";
import BaseLayout from "../layouts/BaseLayout.astro";
import CurrentStatus from "../features/inicio/CurrentStatus.astro";
import DevelopmentStatus from "../features/inicio/DevelopmentStatus.astro";
import FocusAreas from "../features/inicio/FocusAreas.astro";
import IdePreview from "../features/inicio/IdePreview.astro";
import LatestUpdate from "../features/atualizacoes/LatestUpdate.astro";
import "../features/inicio/inicio.css";
import "../features/inicio/secoes.css";
import "../features/inicio/desenvolvimento.css";
import { developmentSnapshot } from "../data/development";
import {
  discordUrl,
  publicVersion,
  releaseUrl,
  repositoryUrl,
  sitePath,
} from "../site";

// O hero é o maior elemento da primeira tela: largura certa por tela
// (srcset) e prioridade de rede alta. As dimensões vêm do resultado, nunca
// de wallpaperSource.width: ler uma propriedade da imagem importada faz o
// Astro publicar o PNG original (2 MB) junto, sem nenhuma página usá-lo.
const wallpaper = await getImage({
  src: wallpaperSource,
  format: "webp",
  quality: 76,
  widths: [768, 1280, 1672],
  sizes: "100vw",
});
---

<BaseLayout
  current="home"
  title="IDE open source para C, C++, Rust e Python"
  description={`IDE open source para C, C++, Rust e Python, feita para firmware, sistemas, Linux embarcado e IoT. Beta público ${publicVersion} para Linux x86_64, sem telemetria.`}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media" aria-hidden="true">
      <img
        class="hero-bg"
        src={wallpaper.src}
        srcset={wallpaper.srcSet.attribute}
        sizes="100vw"
        width={wallpaper.attributes["width"]}
        height={wallpaper.attributes["height"]}
        alt=""
        fetchpriority="high"
      />
      <div class="hero-shine"></div>
    </div>
    <div class="shell hero-layout">
      <div class="hero-art" aria-hidden="true"></div>
      <div class="hero-copy enter">
        <p class="hero-overline">
          <span aria-hidden="true">∭</span> BETA PÚBLICO {publicVersion} · LINUX
          X86_64
        </p>
        <h1 id="hero-title">
          O ambiente do seu projeto, <em>à vista.</em>
        </h1>
        <p class="hero-lead">
          A Kinein Vectis é uma IDE open source para C, C++, Rust e Python,
          feita para firmware, sistemas, Linux embarcado e IoT. Ela lê o projeto
          e o ambiente, mostra o que encontrou, explica o que será usado e deixa
          a decisão com você.
        </p>
        <div class="hero-actions">
          <a
            class="button button-primary"
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Baixar a {publicVersion} para Linux{" "}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-quiet" href={sitePath("/aprender/")}>
            Começar pelo Guia da IDE
          </a>
        </div>
        <p class="hero-meta">
          Open source, MIT ou Apache-2.0 <span aria-hidden="true">·</span> Sem
          telemetria <span aria-hidden="true">·</span> Sem IA embutida
        </p>
      </div>
    </div>
  </section>

  <LatestUpdate />

  <nav class="journey shell auto-grid reveal" aria-label="Caminhos rápidos">
    <a class="card card-interactive" href="#estado">
      <span class="journey-label label">01 / PRESENTE</span>
      <strong>Veja o que já funciona</strong>
      <span class="journey-arrow" aria-hidden="true">
        ↓
      </span>
    </a>
    <a class="card card-interactive" href="#desenvolvimento">
      <span class="journey-label label">02 / EM DESENVOLVIMENTO</span>
      <strong>Acompanhe a {developmentSnapshot.version}</strong>
      <span class="journey-arrow" aria-hidden="true">
        ↓
      </span>
    </a>
    <a class="card card-interactive" href="#foco">
      <span class="journey-label label">03 / DIREÇÃO</span>
      <strong>Veja para onde a Vectis vai</strong>
      <span class="journey-arrow" aria-hidden="true">
        ↓
      </span>
    </a>
  </nav>

  <IdePreview />

  <CurrentStatus />

  <DevelopmentStatus />

  <FocusAreas />

  <section
    id="experiencia"
    class="section shell section-surface"
    aria-labelledby="experiencia-title"
  >
    <div class="section-intro reveal">
      <p class="kicker">COMO A VECTIS LÊ O PROJETO</p>
      <h2 id="experiencia-title">Do encontrado ao efetivo.</h2>
      <p class="section-intro-copy">
        Compilador, toolchain, alvo, sysroot, preset, language server e debugger
        continuam escolhas suas. A IDE torna essa cadeia visível e explicável,
        sem que o fluxo comum exija editar JSON da IDE ou pedir a uma IA para
        fazê-lo.
      </p>
    </div>
    <div class="principle-grid auto-grid reveal-children">
      <article class="principle-card card">
        <span class="card-glyph" aria-hidden="true">
          01
        </span>
        <h3>Detectado</h3>
        <p>
          O que existe na máquina e no projeto: compiladores, SDKs, language
          servers, debuggers e dispositivos.
        </p>
      </article>
      <article class="principle-card card">
        <span class="card-glyph" aria-hidden="true">
          02
        </span>
        <h3>Escolhido</h3>
        <p>
          O que você seleciona quando há mais de um caminho, com as alternativas
          explicadas antes de qualquer mudança.
        </p>
      </article>
      <article class="principle-card card">
        <span class="card-glyph" aria-hidden="true">
          03
        </span>
        <h3>Efetivo</h3>
        <p>
          O que build, testes e depuração realmente usam, e de onde veio cada
          valor.
        </p>
      </article>
    </div>
    <p class="direction-note">
      Esta é a direção do produto: a {publicVersion} ainda não oferece esse
      fluxo completo para todos os projetos e ecossistemas.{" "}
      <a
        class="inline-link"
        href={`${repositoryUrl}#readme`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Leia a visão no README <span aria-hidden="true">↗</span>
      </a>
    </p>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="shell closing-layout reveal">
      <div>
        <p class="kicker">BETA PÚBLICO {publicVersion}</p>
        <h2 id="closing-title">
          Explore o beta. Ajude a definir os próximos fluxos.
        </h2>
        <p>
          Baixe o AppImage, confira o checksum e conte no Discord o que
          funcionou e o que faltou no seu projeto.
        </p>
      </div>
      <div class="closing-actions">
        <a
          class="button button-primary"
          href={releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Baixar a {publicVersion} <span aria-hidden="true">↗</span>
        </a>
        <a
          class="inline-link"
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Entrar no Discord da Vectis <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
