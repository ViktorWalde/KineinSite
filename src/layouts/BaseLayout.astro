---
import { getImage } from "astro:assets";
import shareSource from "../../assets/backgrounds/wallpaper-site.png";
import iconSource from "../../assets/icon-amber.png";
import PageBackground from "../components/PageBackground.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { themeBootValues } from "../scripts/theme-preferences";
import type { SiteSection } from "../site";
import { locales } from "../i18n/config";
import { equivalentRoutes, localeFromPath } from "../i18n/routing";
import { uiFor } from "../i18n/ui";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/background.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/interaction.css";
import "../styles/theme-panel.css";
import "../features/flow/feedback.css";

interface Props {
  title: string;
  description: string;
  current?: SiteSection;
  // Páginas que não devem ser indexadas nem ter endereço canônico (a 404 é
  // servida em qualquer caminho inexistente).
  noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL);
const messages = uiFor(locale);
const equivalents = equivalentRoutes(
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
// Cartão de link (Discord, redes): a imagem do hero, em tamanho de prévia.
const shareImage = await getImage({
  src: shareSource,
  width: 1200,
  format: "jpeg",
  quality: 78,
});
// Ícone da aba e do atalho na tela inicial do celular.
const favicon = await getImage({
  src: iconSource,
  width: 32,
  height: 32,
  format: "png",
});
const touchIcon = await getImage({
  src: iconSource,
  width: 180,
  height: 180,
  format: "png",
});
const pageUrl =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const imageUrl = Astro.site ? new URL(shareImage.src, Astro.site) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* A opção deve estar disponível antes da primeira pintura, inclusive
         quando o CSS externo ainda não chegou na navegação entre páginas. */}
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    {/* Clássico e síncrono: aplica o tema salvo antes da primeira pintura.
         Como módulo no fim do body, ele rodava depois dela, e cada navegação
         mostrava o tema padrão seguido da transição de cor para o salvo. */}
    <script define:vars={themeBootValues}>
      try {
        const root = document.documentElement;
        const theme = localStorage.getItem(themeKey);
        const accent = localStorage.getItem(accentKey);
        if (themes.includes(theme)) root.dataset.theme = theme;
        if (accents.includes(accent)) root.dataset.accent = accent;
      } catch {
        // Sem armazenamento local, vale o padrão do CSS.
      }
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#20262b"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ddd6ca"
      media="(prefers-color-scheme: light)"
    />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Kinein Vectis" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locales[locale].ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl.href} />}
    {pageUrl && <link rel="canonical" href={pageUrl.href} />}
    {Astro.site &&
      !noindex &&
      equivalents.length > 1 &&
      equivalents.map((page) => (
        <link
          rel="alternate"
          hreflang={page.locale}
          href={new URL(page.href, Astro.site).href}
        />
      ))}
    {imageUrl && <meta property="og:image" content={imageUrl.href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} | Kinein Vectis</title>
  </head>
  <body>
    {current !== "home" && <PageBackground />}
    <a class="skip-link" href="#conteudo">
      {messages.skip}
    </a>
    <SiteHeader current={current} locale={locale} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script src="../scripts/theme.ts"></script>
    <script src="../features/flow/visibility.ts"></script>
    <script src="../features/flow/feedback.ts"></script>
  </body>
</html>
