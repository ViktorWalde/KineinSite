---
import { getImage } from "astro:assets";
import shareSource from "../../assets/backgrounds/wallpaper-site.png";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/home.css";
import "../styles/home-sections.css";
import "../styles/development.css";
import "../styles/docs.css";
import "../features/atualizacoes/updates.css";

interface Props {
  title: string;
  description: string;
  current: "home" | "docs" | "updates";
}

const { title, description, current } = Astro.props;
// Cartão de link (Discord, redes): a imagem do hero, em tamanho de prévia.
const shareImage = await getImage({
  src: shareSource,
  width: 1200,
  format: "jpeg",
  quality: 78,
});
const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const imageUrl = Astro.site ? new URL(shareImage.src, Astro.site) : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Kinein Vectis" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl.href} />}
    {pageUrl && <link rel="canonical" href={pageUrl.href} />}
    {imageUrl && <meta property="og:image" content={imageUrl.href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} | Kinein Vectis</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <SiteHeader current={current} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
